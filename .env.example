# =============================================================================
#  Configuração do rAIz. Copie para ".env" (mesma pasta do docker-compose.yml).
#  O .env NÃO vai para o Git. Depois de mudar algo aqui:  docker compose up -d
# =============================================================================

# --- Assistente de IA (balão do dashboard) -----------------------------------
# Qual LLM responde: claude | gemini | ollama
LLM_PROVEDOR=claude

# Claude (Anthropic): chave criada em platform.claude.com > Settings > API Keys
ANTHROPIC_API_KEY=cole-sua-chave-aqui
# Só se a chave foi criada com escopo "Organização" (sem espaço de trabalho): id do espaço, formato wrkspc_...
ANTHROPIC_WORKSPACE_ID=
# Modelo mais barato e rápido do Claude
CLAUDE_MODELO=claude-haiku-5-5

# Gemini (Google AI Studio): só se LLM_PROVEDOR=gemini (use a camada paga com dados reais)
GEMINI_API_KEY=
GEMINI_MODELO=gemini-2.5-flash-lite

# Ollama (local): só se LLM_PROVEDOR=ollama. Suba com: docker compose --profile ollama up -d
# Ollama instalado no Windows em vez do container: OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_URL=http://ollama:11434
OLLAMA_MODELO=qwen2.5:7b

# Tempo máximo (segundos) esperando a resposta da LLM
LLM_TIMEOUT=30

# --- Base de conhecimento (RAG) ----------------------------------------------
# Metodologia do AMS: completo (vai inteira em cada pergunta) | busca (só os trechos mais parecidos)
RAG_MODO=completo
# Quantos trechos das políticas da empresa entram em cada pergunta
RAG_TRECHOS_POLITICA=4
# Embeddings da busca vetorial: local (modelo dentro do agente, recomendado) | ollama | gemini
EMBEDDINGS_PROVEDOR=local

# --- Segurança interna --------------------------------------------------------
# Senha compartilhada entre o Java e os agentes Python (troque por um texto seu)
AGENTES_TOKEN=raiz-agentes-local

# --- API Java -----------------------------------------------------------------
AUTH_ORIGINS=http://127.0.0.1:3000,http://localhost:3000,http://127.0.0.1:8080,http://localhost:8080
# true só quando o site rodar em HTTPS
COOKIE_SECURE=false
