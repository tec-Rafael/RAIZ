# Copie para ".env" (na mesma pasta do docker-compose.yml) e preencha. O .env não vai para o Git.
# Provedor da LLM do assistente: claude (API da Anthropic), gemini (API do Google) ou ollama (local, mais lento)
LLM_PROVEDOR=claude
ANTHROPIC_API_KEY=cole-sua-chave-aqui
CLAUDE_MODELO=claude-haiku-5-5
# Só se usar o Gemini:
GEMINI_API_KEY=
GEMINI_MODELO=gemini-2.5-flash-lite
# Token interno entre o Java e os agentes Python (troque por um valor seu)
AGENTES_TOKEN=raiz-agentes-local
