<link rel="stylesheet" href="/public/css/dashboard.css?v=visual18">
<div class="raizDash">
<%- include('../comum/sidebar', { pagina: 'funcionarios' }) %>
<main class="rdMain">
<p class="rdEyebrow">RAIZ / GESTÃO DE PESSOAS</p>
<p><a class="rdPerson" href="/perfil">Voltar ao meu perfil</a></p>
<div class="rdCard">
	<h1>Funcionários</h1>

	<div class="table-responsive"><table class="table" id="tabelaFuncionarios">
		<thead>
			<tr>
				<th>ID</th>
				<th>Nome</th>
				<th>E-mail</th>
				<th>Posição</th>
				<th>Departamento</th>
				<th></th>
			</tr>
		</thead>
		<tbody></tbody>
	</table></div>
</div>

<script>
	async function carregar() {
		const resposta = await fetch("/api/funcionario/listar");
        if (resposta.status === 401) return window.location.assign('/login');
        if (!resposta.ok) { alert('Não foi possível consultar os funcionários.'); return; }
        const funcionarios = await resposta.json();
		const corpo = document.querySelector("#tabelaFuncionarios tbody");

		corpo.innerHTML = "";

		for (const f of funcionarios) {
			const linha = document.createElement("tr");

            for (const valor of [f.employeeId, f.nome, f.email, f.posicao, f.departmentId ?? '']) {
                const celula = document.createElement('td'); celula.textContent = valor; linha.appendChild(celula);
            }
            const acoes = document.createElement('td');
            if (f.employeeId !== 'ROOT-E0001' && f.employeeId !== <%- JSON.stringify(usuario.employeeId).replace(/</g,'\u003c') %>) {
                const botao = document.createElement('button'); botao.type = 'button';
                botao.className = 'btn btn-sm btn-outline-danger'; botao.textContent = 'Excluir';
                botao.addEventListener('click', () => excluir(f.employeeId)); acoes.appendChild(botao);
            }
            linha.appendChild(acoes);

			corpo.appendChild(linha);
		}
	}

	async function excluir(id) {
		if (!confirm("Excluir funcionário " + id + "?")) return;

		const resposta = await fetch("/api/funcionario/deletar/" + encodeURIComponent(id), { method: "DELETE" });

		if (resposta.ok || resposta.status === 204) {
			carregar();
		} else {
			const corpo = await resposta.json().catch(() => null);
			alert(typeof corpo === "string" ? corpo : (corpo?.message || "Não foi possível excluir"));
		}
	}

	carregar();
</script>

</main>
</div>
