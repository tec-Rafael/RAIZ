<div class="loginSplit">
    <div class="loginSplit__animacao">
        <canvas id="canvasLoginEstacoes" class="canvasLoginEstacoes" aria-hidden="true"></canvas>
    </div>
    <div class="loginSplit__painel">
        <img src="/public/img/logo.png" class="loginSplit__logo" alt="rAIz">
        <div class="loginSplit__conteudo">
            <h1 class="loginSplit__titulo anim-pendente" id="tituloLogin">
                <span class="tituloLogin__parte">Analisando a</span>
                <strong class="tituloLogin__parte tituloLogin__ia">IA</strong>
                <span class="tituloLogin__parte">na</span>
                <strong class="tituloLogin__parte tituloLogin__raiz">raiz</strong>
                <span class="tituloLogin__parte">da sua</span>
                <strong class="tituloLogin__parte tituloLogin__empresa">empresa.</strong>
            </h1>
            <form id="formLoginUsuario" method="post" class="loginSplit__form">
                <div class="mb-3">
                    <label class="form-label">Email</label>
                    <input type="email" name="email" autocomplete="username" required class="form-control" id="inputEmailLogin">
                </div>
                <div class="mb-3">
                    <div class="loginSplit__linhaSenha">
                        <label class="form-label">Senha</label>
                        <label class="esqueciSenha">Esqueci minha senha</label>
                    </div>
                    <div class="input-group">
                        <input type="password" name="senha" autocomplete="current-password" required class="form-control" id="inputSenhaLogin">
                        <a class="btn btn-outline-secondary" onclick="alternarOlho()" id="toggleSenha">
                            <i class="bi bi-eye" id="iconeOlho"></i>
                        </a>
                    </div>
                </div>
                <div class="divBtn">
                    <button type="button" onclick="realizarLoginUsuario()" class="btn btn-success btnLoginPlataforma">Entrar na plataforma</button>
                </div>
            </form>
        </div>
    </div>
</div>


    <script src="/public/js/script.js?v=auth1"></script>
    <%# Fundo animado (ciclo da árvore) e título animado. ?v= = cache-busting (estáticos com maxAge de 30 dias). %>
    <script src="/public/js/loginEstacoes.js?v=3"></script>
    <script src="https://cdn.jsdelivr.net/npm/gsap@3.13.0/dist/gsap.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/gsap@3.13.0/dist/SplitText.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/gsap@3.13.0/dist/ScrambleTextPlugin.min.js"></script>
    <script src="/public/js/loginTitulo.js?v=1"></script>
