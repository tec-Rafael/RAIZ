<!-- GSAP: só carregado aqui na landing page (não no cabecalho.ejs global) para não pesar as outras telas. -->
<script src="https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/gsap.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/ScrollTrigger.min.js"></script>
<script>
	(function () {
		var reduzMovimento = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
		if (reduzMovimento || typeof gsap === "undefined") return;

		gsap.registerPlugin(ScrollTrigger);

		// Hero: entra assim que a página carrega.
		gsap.timeline()
			.from(".landingHero h1", { opacity: 0, y: 24, duration: 0.7, ease: "power2.out" })
			.from(".landingHero__text", { opacity: 0, y: 16, duration: 0.6, ease: "power2.out" }, "-=0.35");

		// Demais seções: revelam conforme o usuário rola a página.
		document.querySelectorAll(".landingSection, .landingCta").forEach(function (secao) {
			var alvos = secao.querySelectorAll(".container > *");

			gsap.from(alvos, {
				opacity: 0,
				y: 30,
				duration: 0.6,
				ease: "power2.out",
				stagger: 0.12,
				scrollTrigger: {
					trigger: secao,
					start: "top 80%"
				}
			});
		});
	})();
</script>
