<link rel="stylesheet" href="/public/css/dashboard.css?v=nav3">
<link rel="stylesheet" href="/public/css/perfil.css?v=perfil2">
<div class="raizDash perfilPage">
  <%- include('../comum/sidebar', { pagina: 'perfil' }) %>
  <main class="rdMain">
    <header class="rdHeader perfilHeader">
      <div><p class="rdEyebrow">RAIZ / MEU ESPAÇO</p><h1>Seu perfil, suas conexões.</h1><p class="rdMuted">Acompanhe como a IA participa da sua rotina.</p></div>
      <button id="perfilSair" type="button" class="rdButton perfilLogout"><i class="bi bi-box-arrow-right" aria-hidden="true"></i> Sair do sistema</button>
    </header>
    <p id="perfilSairStatus" class="perfilFeedback" role="alert" hidden></p>
    <section class="rdCard perfilIdentity" aria-labelledby="perfilIdentityTitle">
      <div class="perfilAvatar" aria-hidden="true"><%= usuario.nome.trim().split(/\s+/).filter((_,i,a) => i === 0 || i === a.length - 1).map(p => p[0]).join('').slice(0,2).toUpperCase() %></div>
      <div class="perfilIdentityText"><p class="rdEyebrow">BEM-VINDO(A) À SUA RAIZ</p><h2 id="perfilIdentityTitle"><%= usuario.nome %></h2><p><%= usuario.email %></p></div>
      <span class="rdBadge"><span class="rdLive" aria-hidden="true"></span><%= {COLABORADOR:'Colaborador',GESTOR:'Gestor',ADMINISTRADOR:'Administrador'}[usuario.posicao] %></span>
      <dl class="perfilDetails">
        <div><dt><i class="bi bi-person" aria-hidden="true"></i> Nome</dt><dd><%= usuario.nome %></dd></div>
        <div><dt><i class="bi bi-envelope" aria-hidden="true"></i> E-mail</dt><dd><%= usuario.email %></dd></div>
        <div><dt><i class="bi bi-briefcase" aria-hidden="true"></i> Cargo</dt><dd><%= usuario.jobRole || usuario.posicao %></dd></div>
        <div><dt><i class="bi bi-shield-check" aria-hidden="true"></i> Perfil de acesso</dt><dd><%= {COLABORADOR:'Colaborador',GESTOR:'Gestor',ADMINISTRADOR:'Administrador'}[usuario.posicao] %></dd></div>
      </dl>
    </section>
    <section aria-labelledby="perfilConsumptionTitle" class="perfilConsumption">
      <div class="rdCardHead perfilConsumptionHead">
        <div><p class="rdEyebrow">SEU ECOSSISTEMA DE IA</p><h2 id="perfilConsumptionTitle">Cada ferramenta, uma contribuição.</h2><p class="rdMuted">Explore seu consumo de tokens e a distribuição entre as ferramentas.</p></div>
        <label for="perfilPeriodo">Período de análise<select id="perfilPeriodo"><option value="5">P5 · 66 dias</option><option value="historico">Todo o histórico</option></select></label>
      </div>
      <div class="perfilSummary" aria-label="Resumo do consumo">
        <div class="perfilSummaryTotal"><span>Tokens consumidos</span><strong id="perfilTotal">—</strong><small>Entrada + saída no período</small></div>
        <div><span>IA mais utilizada</span><strong id="perfilPrincipal">—</strong><small id="perfilPrincipalDetail">Participação no consumo total</small></div>
        <div><span>Ferramentas em uso</span><strong id="perfilAtivas">—</strong><small id="perfilAtivasDetail">Com consumo no período</small></div>
      </div>
      <div class="perfilStatusRow"><p id="perfilStatus" role="status" aria-live="polite">Consultando consumo…</p><button id="perfilRetry" type="button" class="rdButton rdGhost" hidden>Tentar novamente</button></div>
      <div id="perfilConsumo" class="perfilAiGrid" aria-busy="true"></div>
      <details id="perfilSemUso" class="perfilUnused" hidden><summary id="perfilSemUsoTitle">Ferramentas sem consumo</summary><div id="perfilSemUsoItens" class="perfilUnusedGrid"></div></details>
      <p class="rdFootnote perfilConsumptionNote"><i class="bi bi-info-circle" aria-hidden="true"></i> Tokens são unidades de processamento de texto. Os totais representam seu uso de IA, não valores em dinheiro ou uma medida de produtividade.</p>
    </section>
    <footer class="rdFooter">Seu crescimento começa com uma visão mais clara da sua rotina.</footer>
  </main>
</div>
<script src="/public/js/perfil.js?v=perfil2"></script>
